{
  "pipeline_name": "medical_display_hdr",
  "api_version": "1.3",
  "render_pass": {
    "attachments": [
      {
        "format": "RGBA16_SFLOAT",
        "samples": 1,
        "load_op": "clear",
        "store_op": "store",
        "initial_layout": "undefined",
        "final_layout": "shader_read_only"
      }
    ],
    "depth_attachment": null,
    "color_attachment_count": 1
  },
  "shaders": {
    "vertex": "shaders/medical_render.vert.spv",
    "fragment": "shaders/hdr_tonemapping.frag.spv",
    "compute": "shaders/hdr_tonemapping.glsl"
  },
  "descriptor_sets": [
    {
      "set": 0,
      "bindings": [
        {"binding": 0, "type": "sampler", "count": 1, "stages": ["fragment", "compute"]},
        {"binding": 1, "type": "sampled_image", "count": 1, "stages": ["fragment"]},
        {"binding": 2, "type": "sampled_image", "count": 1, "stages": ["fragment", "compute"]},
        {"binding": 3, "type": "storage_image", "count": 1, "stages": ["compute"]},
        {"binding": 4, "type": "uniform_buffer", "count": 1, "stages": ["fragment", "compute"]}
      ]
    },
    {
      "set": 1,
      "bindings": [
        {"binding": 0, "type": "uniform_buffer", "count": 1, "stages": ["fragment"]}
      ]
    }
  ],
  "push_constants": {
    "size": 128,
    "stages": ["fragment", "compute"]
  },
  "viewport": {
    "width": 3840,
    "height": 2160
  },
  "scissor": {
    "extent": {"width": 3840, "height": 2160}
  },
